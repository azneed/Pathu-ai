AI_PRIMARY=gemini
AI_FALLBACK=openrouter
# Skip a rate-limited provider for this many seconds (in-memory; default 300)
AI_PROVIDER_COOLDOWN_SECONDS=300

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (local or remote). Used only when AI_PRIMARY or AI_FALLBACK is "ollama".
# Remote example: OLLAMA_BASE_URL=https://ollama.example.com (no credentials in the URL).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional bearer token, sent as "Authorization: Bearer <key>" (e.g. to an auth proxy in front of a
# remote Ollama). Leave empty for a local Ollama; never commit it.
OLLAMA_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloud hosts (e.g. Render) inject PORT; set HOST=0.0.0.0 there so the service is reachable.
PORT=3001
HOST=127.0.0.1

# Shared API secret; clients send "Authorization: Bearer <secret>". Required when HOST is not
# loopback (the server refuses to start otherwise). Generate a long random value, never commit it.
# Mobile builds read the same value from EXPO_PUBLIC_PATHU_API_SECRET in mobile/pathu/.env.
PATHU_API_SECRET=
DATABASE_PATH=./data/andru.db

# IANA timezone for scheduled/recurring clock times (defaults to OS timezone)
ANDRU_TIMEZONE=

# YouTube Data API v3 key (server-side only; never exposed to the browser)
YOUTUBE_API_KEY=

# Audius API key (server-side only; never exposed to the browser)
AUDIUS_API_KEY=

# Smart-home backend: "simulated" (default, local SQLite state) or "homeassistant".
# homeassistant requires HOME_ASSISTANT_URL and HOME_ASSISTANT_TOKEN; the server refuses to start
# without them and never falls back to simulated devices.
DEVICE_BACKEND=simulated
# Home Assistant base URL reachable from this server, e.g. http://homeassistant.local:8123
HOME_ASSISTANT_URL=
# Long-lived access token (HA profile > Security). Prefer a dedicated non-admin HA user; never commit it.
HOME_ASSISTANT_TOKEN=
# Timeout per Home Assistant request in milliseconds (1-60000, default 5000)
HOME_ASSISTANT_TIMEOUT_MS=5000
