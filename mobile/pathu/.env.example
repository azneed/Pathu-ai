# Pathu API base URL (USB Android via adb reverse → PC :3001)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
# Must match the backend's PATHU_API_SECRET (sent as Authorization: Bearer). Leave empty for a
# local backend without auth. Also baked into the native assistant at Android build time.
EXPO_PUBLIC_PATHU_API_SECRET=
